# Copy this file to .env and fill in your Razorpay test credentials.
# Never commit .env to Git!

APP_ENV=development
PAYMENT_GATEWAY=razorpay

# Razorpay Test Mode Credentials (from Razorpay Dashboard -> Account & Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_test_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Node Backend <-> Java Service Auth (must match AAITripBackendBase .env)
JAVA_SERVICE_TOKEN=dev-java-service-token-at-least-32-chars
JAVA_CALLBACK_SECRET=replace-with-32-char-callback-secret-matching-node
NODE_CALLBACK_URL=http://127.0.0.1:4101/internal/v1/payments/events

# Optional PostgreSQL (transaction_management). Leave blank in dev for in-memory mode.
TXN_DB_URL=
TXN_DB_USER=postgres
TXN_DB_PASSWORD=
