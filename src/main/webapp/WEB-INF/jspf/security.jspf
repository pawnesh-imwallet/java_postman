<%!
  private static final int MAX_ORDER_BODY_BYTES = 64 * 1024;
  private static final int MAX_WEBHOOK_BODY_BYTES = 256 * 1024;
  private static final long MAX_AMOUNT_MINOR = 100_000_000L; // Rs 10,00,000 max per single order

  private static void applySecurityHeaders(HttpServletResponse res, boolean isHtml) {
    res.setHeader("X-Content-Type-Options", "nosniff");
    res.setHeader("X-Frame-Options", "DENY");
    res.setHeader("Referrer-Policy", "no-referrer");
    res.setHeader("X-Permitted-Cross-Domain-Policies", "none");
    res.setHeader("Cache-Control", "no-store");
    if (isProductionEnv()) {
      res.setHeader("Strict-Transport-Security", "max-age=31536000; includeSubDomains");
    }
    if (isHtml) {
      res.setHeader("Content-Security-Policy", "default-src 'self'; style-src 'self' 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'");
    }
  }

  private static String sha256Hex(byte[] data) {
    try {
      byte[] digest = MessageDigest.getInstance("SHA-256").digest(data);
      StringBuilder sb = new StringBuilder(digest.length * 2);
      for (byte b : digest) {
        sb.append(Character.forDigit((b >> 4) & 0xF, 16));
        sb.append(Character.forDigit(b & 0xF, 16));
      }
      return sb.toString();
    } catch (Exception e) {
      throw new IllegalStateException("SHA-256 failed", e);
    }
  }

  private static byte[] readBodyCapped(HttpServletRequest req, int maxBytes) throws IOException {
    int cl = req.getContentLength();
    if (cl > maxBytes) return null;
    InputStream in = req.getInputStream();
    ByteArrayOutputStream buf = new ByteArrayOutputStream();
    byte[] chunk = new byte[4096];
    int total = 0;
    int n;
    while ((n = in.read(chunk)) != -1) {
      total += n;
      if (total > maxBytes) return null;
      buf.write(chunk, 0, n);
    }
    return buf.toByteArray();
  }

  private static String clientIp(HttpServletRequest req) {
    String xff = req.getHeader("X-Gateway-Client-IP");
    if (xff != null && !xff.trim().isEmpty()) return xff.trim();
    return req.getRemoteAddr();
  }

  private static boolean isAllowedIp(HttpServletRequest req, String envKey) {
    String csv = cfg(envKey, "");
    if (csv.isEmpty()) return true;
    String ip = clientIp(req);
    for (String allowed : csv.split(",")) {
      if (allowed.trim().equals(ip)) return true;
    }
    return false;
  }

  @SuppressWarnings("unchecked")
  private static boolean checkRateLimit(ServletContext ctx, HttpServletResponse res, String bucket, String ip, int maxPerMinute) throws IOException {
    Map<String, long[]> store;
    synchronized (ctx) {
      store = (Map<String, long[]>) ctx.getAttribute("aaitrip.rateLimit." + bucket);
      if (store == null) {
        store = new ConcurrentHashMap<String, long[]>();
        ctx.setAttribute("aaitrip.rateLimit." + bucket, store);
      }
    }
    long now = System.currentTimeMillis();
    String key = (ip == null || ip.isEmpty()) ? "unknown" : ip;
    long[] entry = store.compute(key, (k, v) -> {
      if (v == null || now - v[0] >= 60_000L) {
        return new long[] { now, 1L };
      }
      v[1]++;
      return v;
    });
    if (store.size() > 10_000) {
      store.entrySet().removeIf(e -> now - e.getValue()[0] >= 60_000L);
    }
    if (entry[1] > maxPerMinute) {
      long retryAfter = Math.max(1L, (60_000L - (now - entry[0]) + 999L) / 1000L);
      res.setStatus(429);
      res.setHeader("Retry-After", String.valueOf(retryAfter));
      res.setContentType("application/json;charset=UTF-8");
      res.getWriter().write("{\"success\":false,\"code\":\"RATE_LIMITED\",\"message\":\"Too many requests\"}");
      return false;
    }
    return true;
  }

  private static boolean isUnsafeJson(JsonElement el, int depth) {
    if (depth > 6) return true;
    if (el == null || el.isJsonNull() || el.isJsonPrimitive()) return false;
    if (el.isJsonArray()) {
      JsonArray arr = el.getAsJsonArray();
      if (arr.size() > 32) return true;
      for (JsonElement item : arr) {
        if (isUnsafeJson(item, depth + 1)) return true;
      }
      return false;
    }
    if (el.isJsonObject()) {
      JsonObject obj = el.getAsJsonObject();
      if (obj.size() > 64) return true;
      for (Map.Entry<String, JsonElement> entry : obj.entrySet()) {
        String k = entry.getKey();
        if ("__proto__".equals(k) || "constructor".equals(k) || "prototype".equals(k)) return true;
        if (isUnsafeJson(entry.getValue(), depth + 1)) return true;
      }
    }
    return false;
  }
%>
