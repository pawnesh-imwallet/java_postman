<%@ page import="java.sql.*" %><%!
  private static String dbUrl() {
    String u = cfg("TXN_DB_URL", "");
    return u.isEmpty() ? cfg("DATABASE_URL", "") : u;
  }

  private static boolean isDbEnabled() {
    String url = dbUrl();
    if (isProductionEnv() && url.isEmpty()) {
      throw new IllegalStateException("TXN_DB_URL (PostgreSQL transaction_management) is required in production");
    }
    return !url.isEmpty();
  }

  private static Connection openDb(ServletContext ctx) throws SQLException {
    try {
      Class.forName("org.postgresql.Driver");
    } catch (ClassNotFoundException e) {
      throw new SQLException("PostgreSQL JDBC driver not found", e);
    }
    String url = dbUrl();
    String user = cfg("TXN_DB_USER", cfg("DB_USER", "postgres"));
    String pass = cfg("TXN_DB_PASSWORD", cfg("DB_PASSWORD", ""));
    Connection conn = DriverManager.getConnection(url, user, pass);
    ensureSchema(ctx, conn);
    return conn;
  }

  private static void ensureSchema(ServletContext ctx, Connection conn) throws SQLException {
    if (Boolean.TRUE.equals(ctx.getAttribute("aaitrip.dbSchemaReady"))) return;
    synchronized (ctx) {
      if (Boolean.TRUE.equals(ctx.getAttribute("aaitrip.dbSchemaReady"))) return;
      try (Statement st = conn.createStatement()) {
        st.executeUpdate(
            "CREATE TABLE IF NOT EXISTS payment_orders (" +
            "  payment_order_id VARCHAR(64) PRIMARY KEY," +
            "  provider VARCHAR(32) NOT NULL," +
            "  provider_order_id VARCHAR(128) NOT NULL UNIQUE," +
            "  booking_id VARCHAR(64) NOT NULL," +
            "  user_id VARCHAR(64) NOT NULL," +
            "  amount_minor BIGINT NOT NULL CHECK (amount_minor > 0)," +
            "  currency VARCHAR(8) NOT NULL," +
            "  status VARCHAR(32) NOT NULL," +
            "  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()," +
            "  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()" +
            ")");
        st.executeUpdate(
            "CREATE TABLE IF NOT EXISTS payment_idempotency (" +
            "  idempotency_key VARCHAR(64) PRIMARY KEY," +
            "  request_fingerprint VARCHAR(256) NOT NULL," +
            "  payment_order_id VARCHAR(64) NOT NULL REFERENCES payment_orders(payment_order_id)," +
            "  checkout_params_json TEXT," +
            "  expires_at TIMESTAMPTZ NOT NULL" +
            ")");
        st.executeUpdate(
            "CREATE TABLE IF NOT EXISTS payment_webhook_events (" +
            "  provider_event_id VARCHAR(128) PRIMARY KEY," +
            "  provider VARCHAR(32) NOT NULL," +
            "  payment_order_id VARCHAR(64) NOT NULL," +
            "  status VARCHAR(32) NOT NULL," +
            "  received_at TIMESTAMPTZ NOT NULL DEFAULT NOW()" +
            ")");
        st.executeUpdate(
            "CREATE TABLE IF NOT EXISTS payment_callback_outbox (" +
            "  event_id VARCHAR(64) PRIMARY KEY," +
            "  payment_order_id VARCHAR(64) NOT NULL," +
            "  booking_id VARCHAR(64) NOT NULL," +
            "  status VARCHAR(32) NOT NULL," +
            "  http_status INT NOT NULL," +
            "  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()" +
            ")");
      }
      ctx.setAttribute("aaitrip.dbSchemaReady", Boolean.TRUE);
    }
  }

  private static Map<String, Object> rowToOrder(ResultSet rs) throws SQLException {
    Map<String, Object> o = new LinkedHashMap<String, Object>();
    o.put("paymentOrderId", rs.getString("payment_order_id"));
    o.put("provider", rs.getString("provider"));
    o.put("providerOrderId", rs.getString("provider_order_id"));
    o.put("bookingId", rs.getString("booking_id"));
    o.put("userId", rs.getString("user_id"));
    o.put("amountMinor", rs.getLong("amount_minor"));
    o.put("currency", rs.getString("currency"));
    o.put("status", rs.getString("status"));
    o.put("createdAt", rs.getTimestamp("created_at").toInstant().toString());
    return o;
  }

  private static Map<String, Object> repoFindOrderById(ServletContext ctx, String paymentOrderId) throws SQLException {
    if (!isDbEnabled()) {
      return getOrdersStore(ctx).get(paymentOrderId);
    }
    try (Connection conn = openDb(ctx);
         PreparedStatement ps = conn.prepareStatement("SELECT * FROM payment_orders WHERE payment_order_id = ?")) {
      ps.setString(1, paymentOrderId);
      try (ResultSet rs = ps.executeQuery()) {
        return rs.next() ? rowToOrder(rs) : null;
      }
    }
  }

  private static Map<String, Object> repoFindOrderByProviderId(ServletContext ctx, String providerOrderId) throws SQLException {
    if (!isDbEnabled()) {
      String id = getProviderIndex(ctx).get(providerOrderId);
      return (id == null) ? null : getOrdersStore(ctx).get(id);
    }
    try (Connection conn = openDb(ctx);
         PreparedStatement ps = conn.prepareStatement("SELECT * FROM payment_orders WHERE provider_order_id = ?")) {
      ps.setString(1, providerOrderId);
      try (ResultSet rs = ps.executeQuery()) {
        return rs.next() ? rowToOrder(rs) : null;
      }
    }
  }

  private static void repoSaveNewOrder(
      ServletContext ctx,
      String idempotencyKey,
      String fingerprint,
      Map<String, Object> order,
      Object checkoutParams,
      long expiresAtMs) throws SQLException {
    if (!isDbEnabled()) {
      getOrdersStore(ctx).put(String.valueOf(order.get("paymentOrderId")), order);
      getProviderIndex(ctx).put(String.valueOf(order.get("providerOrderId")), String.valueOf(order.get("paymentOrderId")));
      Map<String, Object> entry = new LinkedHashMap<String, Object>();
      entry.put("fingerprint", fingerprint);
      entry.put("order", order);
      entry.put("checkoutParams", checkoutParams);
      entry.put("expiresAtMs", Long.valueOf(expiresAtMs));
      getIdempotencyStore(ctx).put(idempotencyKey, entry);
      return;
    }

    try (Connection conn = openDb(ctx)) {
      conn.setAutoCommit(false);
      try {
        try (PreparedStatement ps = conn.prepareStatement(
            "INSERT INTO payment_orders (payment_order_id, provider, provider_order_id, booking_id, user_id, amount_minor, currency, status) VALUES (?, ?, ?, ?, ?, ?, ?, ?)")) {
          ps.setString(1, String.valueOf(order.get("paymentOrderId")));
          ps.setString(2, String.valueOf(order.get("provider")));
          ps.setString(3, String.valueOf(order.get("providerOrderId")));
          ps.setString(4, String.valueOf(order.get("bookingId")));
          ps.setString(5, String.valueOf(order.get("userId")));
          ps.setLong(6, ((Number) order.get("amountMinor")).longValue());
          ps.setString(7, String.valueOf(order.get("currency")));
          ps.setString(8, String.valueOf(order.get("status")));
          ps.executeUpdate();
        }
        try (PreparedStatement ps = conn.prepareStatement(
            "INSERT INTO payment_idempotency (idempotency_key, request_fingerprint, payment_order_id, checkout_params_json, expires_at) VALUES (?, ?, ?, ?, ?) " +
            "ON CONFLICT (idempotency_key) DO UPDATE SET request_fingerprint = EXCLUDED.request_fingerprint, payment_order_id = EXCLUDED.payment_order_id, checkout_params_json = EXCLUDED.checkout_params_json, expires_at = EXCLUDED.expires_at")) {
          ps.setString(1, idempotencyKey);
          ps.setString(2, fingerprint);
          ps.setString(3, String.valueOf(order.get("paymentOrderId")));
          ps.setString(4, checkoutParams != null ? GSON.toJson(checkoutParams) : null);
          ps.setTimestamp(5, new java.sql.Timestamp(expiresAtMs));
          ps.executeUpdate();
        }
        conn.commit();
      } catch (SQLException e) {
        conn.rollback();
        throw e;
      }
    }
  }

  private static Map<String, Object> repoFindIdempotency(ServletContext ctx, String idempotencyKey) throws SQLException {
    long now = System.currentTimeMillis();
    if (!isDbEnabled()) {
      Map<String, Object> e = getIdempotencyStore(ctx).get(idempotencyKey);
      if (e != null && ((Long) e.get("expiresAtMs")).longValue() > now) return e;
      return null;
    }
    try (Connection conn = openDb(ctx);
         PreparedStatement ps = conn.prepareStatement(
             "SELECT i.request_fingerprint, i.checkout_params_json, i.expires_at, o.* " +
             "FROM payment_idempotency i JOIN payment_orders o ON i.payment_order_id = o.payment_order_id " +
             "WHERE i.idempotency_key = ? AND i.expires_at > NOW()")) {
      ps.setString(1, idempotencyKey);
      try (ResultSet rs = ps.executeQuery()) {
        if (!rs.next()) return null;
        Map<String, Object> e = new LinkedHashMap<String, Object>();
        e.put("fingerprint", rs.getString("request_fingerprint"));
        e.put("order", rowToOrder(rs));
        String cp = rs.getString("checkout_params_json");
        e.put("checkoutParams", cp != null ? GSON.fromJson(cp, Map.class) : null);
        return e;
      }
    }
  }

  /**
   * Records provider webhook eventId and updates order status atomically.
   * Returns true if new event, false if duplicate webhook replay.
   */
  @SuppressWarnings("unchecked")
  private static boolean repoRecordWebhookAndUpdate(
      ServletContext ctx,
      String providerEventId,
      String provider,
      String paymentOrderId,
      String newStatus) throws SQLException {
    if (!isDbEnabled()) {
      Set<String> seen;
      synchronized (ctx) {
        seen = (Set<String>) ctx.getAttribute("aaitrip.seenWebhooks");
        if (seen == null) {
          seen = ConcurrentHashMap.newKeySet();
          ctx.setAttribute("aaitrip.seenWebhooks", seen);
        }
      }
      if (!seen.add(providerEventId)) return false;
      Map<String, Object> order = getOrdersStore(ctx).get(paymentOrderId);
      if (order != null) order.put("status", newStatus);
      return true;
    }
    try (Connection conn = openDb(ctx)) {
      conn.setAutoCommit(false);
      try {
        int inserted;
        try (PreparedStatement ps = conn.prepareStatement(
            "INSERT INTO payment_webhook_events (provider_event_id, provider, payment_order_id, status) VALUES (?, ?, ?, ?) ON CONFLICT (provider_event_id) DO NOTHING")) {
          ps.setString(1, providerEventId);
          ps.setString(2, provider);
          ps.setString(3, paymentOrderId);
          ps.setString(4, newStatus);
          inserted = ps.executeUpdate();
        }
        if (inserted == 0) {
          conn.rollback();
          return false;
        }
        try (PreparedStatement ps = conn.prepareStatement(
            "UPDATE payment_orders SET status = ?, updated_at = NOW() WHERE payment_order_id = ?")) {
          ps.setString(1, newStatus);
          ps.setString(2, paymentOrderId);
          ps.executeUpdate();
        }
        conn.commit();
        return true;
      } catch (SQLException e) {
        conn.rollback();
        throw e;
      }
    }
  }
%>
